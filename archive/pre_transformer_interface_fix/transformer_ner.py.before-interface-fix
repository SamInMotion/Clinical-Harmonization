# === MISSING CLASSES/FUNCTIONS (inline since not in evaluate_ner.py) ===
from dataclasses import dataclass

@dataclass
class Span:
    text: str
    start: int
    end: int
    entity_type: str
    doc_id: str = ""

def gold_to_spans(docs):
    """Convert documents to list of gold spans."""
    spans = []
    for doc in docs:
        for entity in doc.all_entities:
            spans.append(Span(
                text=entity["text"],
                start=entity["offset"],
                end=entity["offset"] + entity["length"],
                entity_type=entity["type"],
                doc_id=doc.doc_id
            ))
    return spans

def evaluate_ner(gold_spans, pred_spans):
    """Simple entity-level evaluation."""
    gold_set = set((s.doc_id, s.start, s.end, s.entity_type) for s in gold_spans)
    pred_set = set((s.doc_id, s.start, s.end, s.entity_type) for s in pred_spans)
    
    tp = len(gold_set & pred_set)
    fp = len(pred_set - gold_set)
    fn = len(gold_set - pred_set)
    
    p = tp / (tp + fp) if (tp + fp) > 0 else 0.0
    r = tp / (tp + fn) if (tp + fn) > 0 else 0.0
    f1 = 2 * p * r / (p + r) if (p + r) > 0 else 0.0
    
    return {"precision": p, "recall": r, "f1": f1, "true_positives": tp, "false_positives": fp, "false_negatives": fn}

def evaluate_by_type(gold_spans, pred_spans):
    """Evaluate by entity type."""
    from collections import defaultdict
    gold_by_type = defaultdict(list)
    pred_by_type = defaultdict(list)
    
    for s in gold_spans:
        gold_by_type[s.entity_type].append(s)
    for s in pred_spans:
        pred_by_type[s.entity_type].append(s)
    
    results = {}
    for et in set(gold_by_type.keys()) | set(pred_by_type.keys()):
        results[et] = evaluate_ner(gold_by_type.get(et, []), pred_by_type.get(et, []))
    return results

def print_results(results, by_type=None):
    """Print results."""
    print(f"\nOverall: P={results['precision']:.4f}, R={results['recall']:.4f}, F1={results['f1']:.4f}")
    print(f"TP={results['true_positives']}, FP={results['false_positives']}, FN={results['false_negatives']}")
    if by_type:
        for et, m in sorted(by_type.items()):
            print(f"  {et}: P={m['precision']:.4f}, R={m['recall']:.4f}, F1={m['f1']:.4f}")
